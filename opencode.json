{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "chrome-devtools": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "chrome-devtools-mcp@latest",
          "--executablePath",
          "C:\\Program Files\\BraveSoftware\\Brave-Browser\\Application\\brave.exe",
          "--slim",
          "--headless",
          "--isolated"
        ]
      },
      "github": {
        "type": "remote",
        "url": "https://api.githubcopilot.com/mcp/",
        "headers": {
          "Authorization": "Bearer {file:~/.config/opencode/secrets/github-mcp-token}"
        },
        "oauth": false
      }
    }
  }
}
