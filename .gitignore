# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/test-results-pwa/
/playwright-report/

# next.js
/.next/
/out/
/public/sw.js

# production
/build

# misc
.DS_Store
*.pem

# local root documentation (keep shared project guidance)
/*.md
!/README.md
!/AGENTS.md
!/CLAUDE.md

# local source workbook (the app uses generated JSON)
/Occurrence (1).xlsx

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
